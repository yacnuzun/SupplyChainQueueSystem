# Kullanim: cp .env.example .env
# .env dosyasini ASLA commit'leme (.gitignore'da).
# Asagidaki degerler yerel gelistirme icindir, gercek ortamda degistir.

POSTGRES_PASSWORD=postgres_local_dev

# JWT imzalama anahtari (HS512 icin en az 64 karakter).
# Uretmek icin: openssl rand -base64 64
JWT_SECURITY_KEY=dev_only_change_this_jwt_signing_key_it_must_be_at_least_64_characters_long_0123456789

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Host'ta bu portlar doluysa (ornegin yerel RabbitMQ) degistir:
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Opsiyonel: mail gonderimi icin Gmail adresi ve uygulama sifresi.
# Bos birakilirsa servisler calisir, sadece e-posta gonderilmez.
EMAIL_SENDER=yalcin.uzun96@gmail.com
EMAIL_APP_PASSWORD=mgjhknnxcpiijccn
